INTERNAL_API_BASE_URL=   # 쿠버네티스 클러스터 내부 API 호출 주소. 예: http://contentria-backend-api:8080
PUBLIC_API_BASE_URL=     # 외부 공개 API 호출 주소. 예: https://www.contentria.com
RECAPTCHA_V3_SITE_KEY=   # Google reCAPTCHA v3 공개 사이트 키 (미입력 시 비활성화됩니다)
RECAPTCHA_V2_SITE_KEY=   # Google reCAPTCHA v2 공개 사이트 키 (미입력 시 비활성화됩니다)
