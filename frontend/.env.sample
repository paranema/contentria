# The API as the Next.js server reaches it, without /api (local: http://localhost:8080)
NEXT_PUBLIC_API_BASE_URL=
# The API as the browser reaches it, with /api (local: http://localhost:8080/api)
NEXT_PUBLIC_EXTERNAL_API_BASE_URL=
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=
NEXT_PUBLIC_RECAPTCHA_V2_CHECKBOX_SITE_KEY=

# Cloudflare R2 CDN base URL for image serving
NEXT_PUBLIC_CDN_BASE_URL=https://images.contentria.com

