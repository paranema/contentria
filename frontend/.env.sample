# Next.js 서버(SSR, Server Action, proxy)가 백엔드를 호출하는 주소 (/api 제외)
# 로컬 기본값: http://localhost:8080, 클러스터 예시: http://contentria-backend-api:8080
API_BASE_URL=http://localhost:8080

# 브라우저가 직접 이동하는 백엔드 공개 주소 (/api 포함, Google OAuth 시작 경로에 사용)
# 동일 도메인 게이트웨이 뒤에 배포할 때는 /api 기본값을 사용하며, 로컬처럼 포트가 다를 때 지정한다.
EXTERNAL_API_BASE_URL=http://localhost:8080/api

# Google reCAPTCHA 공개 사이트 키 (로컬 개발 시 비워 두면 비활성화)
RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V2_CHECKBOX_SITE_KEY=

# *.contentria.com, *.r2.dev 외의 별도 이미지 도메인을 빌드 시 추가 허용할 때만 지정
# CDN_BASE_URL=
