apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: contentria-{{ gitops_env }}
  namespace: argocd
spec:
  project: default
  source:
    repoURL: {{ gitops_repo_url | to_json }}
    targetRevision: {{ gitops_revision | to_json }}
    path: infra/gitops/01-bootstrap/{{ gitops_env }}
    directory:
      recurse: false
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    retry:
      limit: 5
      backoff:
        duration: 10s
        factor: 2
        maxDuration: 3m
