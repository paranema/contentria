# apps/migrator가 읽는 환경 변수 (src/main/kotlin/.../Migrator.kt의 main). 모두 필수이고 기본값이 없다.
# 컨텍스트마다 그 컨텍스트의 마이그레이션 롤로 접속한다. 롤은 infra/database/contentria-v2로 만든다.
# 로컬 실행: 이 파일을 같은 폴더의 .env로 복사해 값을 채운다. .env는 git이 무시한다.
#   IntelliJ: EnvFile 플러그인에 apps/migrator/.env를 지정한다.
#   Docker:   docker run --env-file backend/apps/migrator/.env ... (컨테이너 안의 localhost는 컨테이너 자신이다)
# 값은 따옴표 없이 쓴다. --env-file은 따옴표를 값의 일부로 읽는다.
#
# [비밀] 운영에서는 Kubernetes Secret으로 넣는다. 표시가 없는 값은 ConfigMap에 둔다.

MIGRATION_DATABASE_URL=jdbc:postgresql://localhost:5432/contentria_v2

MEMBER_MIGRATOR_USERNAME=member_migrator
# [비밀]
MEMBER_MIGRATOR_PASSWORD=

PUBLISHING_MIGRATOR_USERNAME=publishing_migrator
# [비밀]
PUBLISHING_MIGRATOR_PASSWORD=

INTERACTION_MIGRATOR_USERNAME=interaction_migrator
# [비밀]
INTERACTION_MIGRATOR_PASSWORD=

NOTIFICATION_MIGRATOR_USERNAME=notification_migrator
# [비밀]
NOTIFICATION_MIGRATOR_PASSWORD=

MEDIA_MIGRATOR_USERNAME=media_migrator
# [비밀]
MEDIA_MIGRATOR_PASSWORD=

ANALYTICS_MIGRATOR_USERNAME=analytics_migrator
# [비밀]
ANALYTICS_MIGRATOR_PASSWORD=
