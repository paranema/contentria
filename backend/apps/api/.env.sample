# apps/api가 읽는 환경 변수 (src/main/resources/application.yml).

# 데이터베이스 (PostgreSQL 17, infra/database/contentria-v2로 만든 롤)
DATABASE_URL=jdbc:postgresql://localhost:5432/contentria_v2
DATABASE_USERNAME=api_app
DATABASE_PASSWORD=

# 컨텍스트 사이의 이벤트
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# 회원: 토큰과 쿠키
# Base64로 인코딩한 256비트 이상의 키. 만들기: openssl rand -base64 32
MEMBER_ACCESS_TOKEN_SECRET=
# 로컬은 http라서 끈다. 운영에서는 이 줄을 두지 않는다(기본값 true).
MEMBER_COOKIE_SECURE=false

# 회원: 구글 로그인 (구글 콘솔의 OAuth 클라이언트)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}

# 회원: 사람 확인 (reCAPTCHA)
# 로컬은 off. 운영에서는 이 줄을 두지 않는다(기본값 google).
MEMBER_RECAPTCHA_MODE=off
GOOGLE_RECAPTCHA_V3_SECRET_KEY=
GOOGLE_RECAPTCHA_V2_SECRET_KEY=
MEMBER_RECAPTCHA_MINIMUM_SCORE=0.5

# 회원: 메일
# 로컬은 log(메일 대신 코드와 링크를 로그에 쓴다). 운영에서는 이 줄을 두지 않는다(기본값 smtp).
MEMBER_MAIL_MODE=log
MEMBER_MAIL_FROM=no-reply@contentria.com

# 회원: 프론트엔드 주소
MEMBER_PASSWORD_LINK_URL=http://localhost:3000/password
MEMBER_SOCIAL_LOGIN_SUCCESS_URL=http://localhost:3000/login/callback
MEMBER_SOCIAL_LOGIN_FAILURE_URL=http://localhost:3000/login
MEMBER_SOCIAL_LINK_RESULT_URL=http://localhost:3000/dashboard/settings

# 분석
# 방문자 해시의 키. 32자 이상. 만들기: openssl rand -base64 32
ANALYTICS_VISITOR_KEY_SECRET=

# 미디어 (Cloudflare R2. 로컬은 S3 API가 같은 MinIO로 대신할 수 있다)
MEDIA_PUBLIC_BASE_URL=https://images.contentria.com
R2_ENDPOINT=
R2_BUCKET_NAME=contentria
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
