# apps/api가 읽는 환경 변수 (src/main/resources/application.yml).
# 로컬 실행: 이 파일을 같은 폴더의 .env로 복사해 값을 채운다. .env는 git이 무시한다.
#   IntelliJ: EnvFile 플러그인에 apps/api/.env를 지정한다.
#   Docker:   docker run --env-file backend/apps/api/.env ... (컨테이너 안의 localhost는 컨테이너 자신이다)
# 값은 따옴표 없이 쓴다. --env-file은 따옴표를 값의 일부로 읽는다.
#
# [필수] 기본값이 없다. 비어 있으면 뜨지 않거나 그 기능이 동작하지 않는다.
# [비밀] 운영에서는 Kubernetes Secret으로 넣는다. 표시가 없는 값은 ConfigMap에 둔다.
# 주석 처리한 줄은 기본값이다. 바꿀 때만 주석을 푼다. KEY=처럼 비워 두면 기본값이 아니라 빈 문자열이 된다.

# 데이터베이스와 Kafka의 로컬 값은 bootRun이 띄우는 compose.yaml에 맞췄다. 기본 포트에 10000을 더한 포트다.

# ---- 데이터베이스 (PostgreSQL 17, infra/database/contentria-v2로 만든 롤)
# 로컬은 compose의 PostgreSQL. 운영에서는 이 줄을 두지 않거나 실제 주소로 바꾼다(기본값 localhost:5432).
DATABASE_URL=jdbc:postgresql://localhost:15432/contentria_v2
# DATABASE_USERNAME=api_app
# [필수][비밀] api_app의 비밀번호. 로컬 compose는 local
DATABASE_PASSWORD=local

# ---- 컨텍스트 사이의 이벤트
# 로컬은 compose의 Kafka. 운영에서는 이 줄을 두지 않거나 실제 주소로 바꾼다(기본값 localhost:9092).
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# ---- 회원: 토큰과 쿠키
# [필수][비밀] Base64로 인코딩한 256비트 이상의 키. 만들기: openssl rand -base64 32
MEMBER_ACCESS_TOKEN_SECRET=
# 로컬은 http라서 끈다. 운영에서는 이 줄을 두지 않는다(기본값 true).
MEMBER_COOKIE_SECURE=false

# ---- 회원: 구글 로그인 (구글 콘솔의 OAuth 클라이언트)
# [필수][비밀] 구글 로그인을 쓰지 않을 때도 값이 있어야 뜬다
GOOGLE_CLIENT_ID=
# [필수][비밀]
GOOGLE_CLIENT_SECRET=
# 프록시 뒤에서는 구글에 등록한 주소로 정한다. 로컬 기본값은 http://localhost:8080/api/login/oauth2/code/google이 된다.
# GOOGLE_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}

# ---- 회원: 사람 확인 (reCAPTCHA)
# 로컬은 off. 운영에서는 이 줄을 두지 않는다(기본값 google).
MEMBER_RECAPTCHA_MODE=off
# [비밀] MEMBER_RECAPTCHA_MODE가 google일 때만 필요하다
# GOOGLE_RECAPTCHA_V3_SECRET_KEY=
# GOOGLE_RECAPTCHA_V2_SECRET_KEY=
# MEMBER_RECAPTCHA_MINIMUM_SCORE=0.5

# ---- 회원: 메일
# 로컬은 log(메일 대신 코드와 링크를 로그에 쓴다). 운영에서는 이 줄을 두지 않는다(기본값 smtp).
MEMBER_MAIL_MODE=log
# MEMBER_MAIL_FROM=no-reply@contentria.com

# ---- 회원: 프론트엔드 주소
# MEMBER_PASSWORD_LINK_URL=http://localhost:3000/password
# MEMBER_SOCIAL_LOGIN_SUCCESS_URL=http://localhost:3000/login/callback
# MEMBER_SOCIAL_LOGIN_FAILURE_URL=http://localhost:3000/login
# MEMBER_SOCIAL_LINK_RESULT_URL=http://localhost:3000/dashboard/settings

# ---- 분석
# [필수][비밀] 방문자 해시의 키. 32자 이상. 만들기: openssl rand -base64 32
ANALYTICS_VISITOR_KEY_SECRET=

# ---- 미디어 (Cloudflare R2)
# 버킷은 환경마다 따로 둔다. 로컬은 개발용 버킷과 그 버킷에만 권한이 있는 토큰을 쓴다. 운영 버킷의 토큰은 넣지 않는다.
# [필수] 이미지와 영상을 내주는 공개 주소. 개발용 버킷의 r2.dev 주소나 연결한 도메인
MEDIA_PUBLIC_BASE_URL=
# [필수] S3 API 주소. https://<계정 ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# [필수] 로컬은 개발용 버킷
R2_BUCKET_NAME=contentria-media-dev
# [필수][비밀] 이 버킷에만 Object Read & Write 권한이 있는 R2 API 토큰
R2_ACCESS_KEY_ID=
# [필수][비밀]
R2_SECRET_ACCESS_KEY=
