# apps/worker가 읽는 환경 변수 (src/main/resources/application.yml).
# Cloudflare 쪽 설정은 docs/operations/cloudflare-video-pipeline.md에 있다.
# 로컬 실행: 이 파일을 같은 폴더의 .env로 복사해 값을 채운다. .env는 git이 무시한다.
#   IntelliJ: EnvFile 플러그인에 apps/worker/.env를 지정한다.
#   Docker:   docker run --env-file backend/apps/worker/.env ... (컨테이너 안의 localhost는 컨테이너 자신이다)
# 값은 따옴표 없이 쓴다. --env-file은 따옴표를 값의 일부로 읽는다.
#
# [필수] 기본값이 없다. 비어 있으면 뜨지 않거나 그 기능이 동작하지 않는다.
# [비밀] 운영에서는 Kubernetes Secret으로 넣는다. 표시가 없는 값은 ConfigMap에 둔다.
# 주석 처리한 줄은 기본값이다. 바꿀 때만 주석을 푼다. KEY=처럼 비워 두면 기본값이 아니라 빈 문자열이 된다.

# ---- 데이터베이스 (PostgreSQL 17, infra/database/contentria-v2로 만든 롤)
# DATABASE_URL=jdbc:postgresql://localhost:5432/contentria_v2
# DATABASE_USERNAME=worker_app
# [필수][비밀] worker_app의 비밀번호
DATABASE_PASSWORD=

# ---- 미디어 (Cloudflare R2. 로컬은 S3 API가 같은 MinIO로 대신할 수 있다)
# [필수] 이미지와 영상을 내주는 공개 주소. MinIO라면 http://localhost:9000/<버킷>
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/contentria-media
# [필수] S3 API 주소. R2는 https://<계정 ID>.r2.cloudflarestorage.com
R2_ENDPOINT=http://localhost:9000
# [필수]
R2_BUCKET_NAME=contentria-media
# [필수][비밀]
R2_ACCESS_KEY_ID=
# [필수][비밀]
R2_SECRET_ACCESS_KEY=

# ---- 영상 큐 (Cloudflare Queues의 http_pull 소비자)
# [필수]
CLOUDFLARE_ACCOUNT_ID=
# [필수]
CF_QUEUE_ID=
# [필수][비밀] Account → Queues → Edit 권한의 API 토큰
CF_API_TOKEN=
# WORKER_POLL_INTERVAL=5s

# ---- 변환 도구 (컨테이너 이미지에는 들어 있다. 로컬은 PATH에 있으면 된다)
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
